# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# LLM provider: "gemini" (default) or "ollama".
# With "gemini", set GEMINI_API_KEY below. If the key is missing, the app
# automatically falls back to Ollama so it still runs.
LLM_PROVIDER=gemini
# Embedding provider: "st" (sentence-transformers BAAI/bge-m3 in-process,
# default, deployable, 1024-dim), "ollama", or "gemini".
EMBEDDING_PROVIDER=st

# ---------------------------------------------------------------------------
# Ollama (local, default)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=bge-m3:latest

# ---------------------------------------------------------------------------
# Gemini (switchable) - free API key from https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.7-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------------------------------------------------------------------------
# sentence-transformers embedding model (in-process, default embedder)
# ---------------------------------------------------------------------------
ST_EMBED_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Embedding dimension. bge-m3 = 1024 (matches the loaded graph vector schema).
# ---------------------------------------------------------------------------
EMBED_DIM=1024

# ---------------------------------------------------------------------------
# TigerGraph Savanna (or local docker)
# ---------------------------------------------------------------------------
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPH=OlympicsKG
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_SECRET=
# For Savanna/cloud, a REST++ / GSQL token or secret is typically required.
TG_RESTPP_PORT=443
TG_GSQL_PORT=443

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
CORPUS_PATH=../dataset/corpus/corpus.jsonl
EVAL_PUBLIC_PATH=../dataset/questions/eval_public.jsonl
EVAL_HIDDEN_PATH=../dataset/questions/eval_hidden.jsonl

# ---------------------------------------------------------------------------
# Retrieval knobs
# ---------------------------------------------------------------------------
RAG_TOP_K=8
GRAPHRAG_TOP_K=8
AGENT_MAX_STEPS=8

# Agentic backend: "graph" (custom LangGraph StateGraph, default) or
# "react" (LangGraph prebuilt create_react_agent with native tool-calling).
AGENT_IMPL=graph
